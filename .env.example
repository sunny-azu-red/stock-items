# HTTP server (0.0.0.0 = reachable from the home network)
HOST=0.0.0.0
PORT=8080

# Database connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stock_items
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=pass

# Currency label used for prices
APP_CURRENCY=EUR

# Optional: time zone for "today" (the system's zone if unset; Docker's is UTC)
# TZ=Europe/Bucharest
