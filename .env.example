# HTTP Server
HOST=0.0.0.0
PORT=8080
# Answer only to these host names/IPs, comma-separated (guards against DNS rebinding; unset: any)
# APP_ALLOWED_HOSTS=pitbox.lan,192.168.1.5

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stock_items
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=pass

# App Settings
APP_CURRENCY=EUR
APP_SKU_SEARCH_URL=https://www.google.com/search?q={q}
# APP_SKU_SEARCH_PREFIX=site:de

# Time zone (unset: the system's)
# TZ=Europe/Berlin
