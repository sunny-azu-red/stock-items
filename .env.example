# HTTP server (0.0.0.0 = reachable from the home network)
HOST=0.0.0.0
PORT=8080

# Database connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stock_items
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=pass

# App
# Currency label shown next to prices
APP_CURRENCY=EUR
# Part number links: the search URL the number is appended to, and text added
# to every search (e.g. site:ro for Romanian shops; leave empty for none)
APP_SKU_SEARCH_URL=https://www.google.com/search?q=
APP_SKU_PREFIX=site:ro

# Optional: time zone for "today" (the system's zone if unset; Docker's is UTC)
# TZ=Europe/Bucharest
